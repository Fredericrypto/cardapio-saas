# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados (Postgres) - free tier no início (Supabase ou Render)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# JWT (autenticação do admin)
JWT_SECRET=troque_por_uma_string_aleatoria_longa
JWT_EXPIRES_IN=7d

# JWT do CLIENTE FINAL — sistema de login separado do admin acima, de
# propósito (segurança: cliente nunca pode logar na área do admin, nem
# por engano de configuração). Gere uma string aleatória DIFERENTE da
# de JWT_SECRET — a aplicação recusa subir se as duas forem iguais.
CUSTOMER_JWT_SECRET=troque_por_outra_string_aleatoria_longa_diferente_da_de_cima
CUSTOMER_JWT_EXPIRES_IN=30d

# Supabase Storage (upload de imagens)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua_service_key_aqui
SUPABASE_BUCKET=cardapio-images

# LocationIQ Geocoding (taxa de entrega por distância) — crie uma conta
# grátis (sem cartão) em https://locationiq.com e pegue o token de acesso
# no dashboard em https://my.locationiq.com/dashboard#/account
LOCATIONIQ_ACCESS_TOKEN=seu_token_aqui

# URL pública do PRÓPRIO backend (usada em callbacks/webhooks que
# precisam de uma URL absoluta, ex: Mercado Pago).
API_PUBLIC_URL=https://sua-api.seudominio.com

# URL pública do frontend-cardapio (cliente final) — usada pra montar
# links dentro de notificações push e nada mais.
CUSTOMER_APP_URL=https://seu-cardapio.seudominio.com

# Chave de criptografia (AES) usada pra guardar o token do Mercado Pago
# de CADA tenant de forma cifrada no banco (nunca em texto puro). Gere
# com: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=troque_por_32_bytes_hex_aleatorios

# Segredo usado pra assinar (HMAC) o código de autenticidade impresso
# no QR code do cupom fiscal — nunca deixa forjar cupom falso. Gere com:
# openssl rand -hex 32
RECEIPT_SIGNING_SECRET=troque_por_outra_string_aleatoria_longa

# Web Push (RFC 8291) — notificações push do app do cliente. Gere UM
# par pra sempre (nunca regenere depois de configurado — toda inscrição
# de push existente quebraria). Comando pra gerar um par novo:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com
