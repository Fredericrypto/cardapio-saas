VITE_API_URL=http://localhost:3000

# URL pública do frontend-cardapio (cliente final) — usada só pra montar
# o link do QR code de cada mesa exibido no painel ("Mesas").
#
# `localhost` só funciona pra escanear o QR no MESMO computador que
# roda o `npm run dev` do cardápio — no celular do cliente, "localhost"
# aponta pro próprio celular, não pro seu computador, e a conexão é
# recusada. Pra testar escaneando com celular de verdade (mesma
# Wi-Fi): troca pelo IP da sua máquina na rede local, ex.
# `http://192.168.0.42:5173` (descobre com `hostname -I` no Linux).
# Em produção: a URL real do domínio publicado do cardápio.
VITE_MENU_BASE_URL=http://localhost:5173
